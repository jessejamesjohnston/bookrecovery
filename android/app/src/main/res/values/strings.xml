    <!-- After-flash guide -->
    <string name="guide_title">Now recover your %1$s</string>
    <string name="guide_unplug">Unplug the drive from your phone.</string>
    <string name="guide_disconnect">On the device you\'re recovering, disconnect anything plugged in, like a mouse or an external drive.</string>
    <string name="guide_keys_chromebook">Press and hold Esc and Refresh, then press Power. Let go of Power when the screen lights up. On a tablet, hold Volume Up, Volume Down and Power for 10 seconds.</string>
    <string name="guide_keys_googlebook">Press and hold Esc and F2, then press and quickly release Power. Let go of Esc and F2 when the screen lights up.</string>
    <string name="guide_insert">When the recovery screen appears, choose to recover using a USB drive, plug in your drive, and follow the steps on screen.</string>
    <string name="guide_erases">Recovery erases everything on the device, including downloaded files.</string>
    <string name="guide_device_chromebook">Chromebook</string>
    <string name="guide_device_googlebook">Googlebook</string>

