    <!-- Drive -->
    <string name="drive_title">Plug in a USB drive</string>
    <string name="drive_body">Everything on it will be erased. Use an adapter if it doesn\'t fit your phone.</string>
    <string name="drive_requirement">Needs %1$s or more</string>
    <string name="drive_empty_title">Waiting for a USB drive</string>
    <string name="drive_empty_body">Plug one in. It shows up here on its own.</string>
    <string name="drive_unknown_name">USB drive</string>
    <string name="drive_size">%1$s</string>
    <string name="drive_checking">Checking size…</string>
    <string name="drive_too_small">%1$s, too small for this image</string>
    <string name="drive_tap_to_check">Tap to check its size</string>
    <string name="drive_confirm_title">Erase %1$s?</string>
    <string name="drive_confirm_body">Everything on this drive will be erased and replaced with the recovery image for %1$s.</string>
    <string name="drive_confirm_hold">Hold to erase and write</string>
    <string name="drive_confirm_holding">Keep holding…</string>
    <string name="drive_confirm_a11y_action">Erase and write</string>
    <string name="drive_cancel">Cancel</string>
    <string name="permission_required_title">Permission needed</string>
    <string name="permission_denied_usb">Bookmend needs permission to use the USB drive. Unplug it, plug it back in, and allow access.</string>

    <!-- Flash steps (UsbFlasher) -->
    <string name="step_opening_local">Opening the image file…</string>
    <string name="step_connecting_server">Connecting to Google…</string>
    <string name="step_unpacking_local">Unpacking the image file…</string>
    <string name="step_downloading_unpacking">Downloading and writing…</string>
    <string name="step_reading_local">Reading the image file…</string>
    <string name="step_downloading">Downloading and writing…</string>
    <string name="step_writing_usb">Writing to the drive…</string>
    <string name="step_verifying">Checking every byte…</string>

    <!-- Flash errors (UsbFlasher) -->
    <string name="error_open_local">Couldn\'t open the image file. It may have been moved or deleted.</string>
    <string name="error_http_server">Google\'s server answered with an error (HTTP %d). Try again in a few minutes.</string>
    <string name="error_invalid_zip">That file doesn\'t contain a recovery image (.bin).</string>
    <string name="error_usb_permission">Android didn\'t allow access to the drive. Unplug it, plug it back in, and allow access.</string>
    <string name="error_not_mass_storage">That isn\'t a USB storage drive.</string>
    <string name="error_claim_interface">Couldn\'t open the drive. Another app may be using it.</string>
    <string name="error_hardware_write">The drive stopped accepting data. It may be faulty or write-protected. Try another drive.</string>
    <string name="error_drive_too_small">This drive is too small for the image. Use a bigger drive.</string>
    <string name="error_verification_failed">The drive didn\'t read back what was written, so it can\'t be trusted. Try again, or use another drive.</string>
    <string name="error_authenticity_failed">The download didn\'t match Google\'s published checksum, so it may be damaged. Try again.</string>
    <string name="error_erase_failed">Couldn\'t erase the drive. It may be write-protected, busy, or unplugged.</string>
    <string name="error_unexpected">Something went wrong: %s</string>

