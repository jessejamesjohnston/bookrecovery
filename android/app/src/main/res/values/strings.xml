    <!-- Welcome -->
    <string name="welcome_title">Fix a Chromebook or Googlebook with your phone</string>
    <string name="welcome_body">Bookmend makes a recovery drive from Google\'s official images, right on your phone. No second computer needed.</string>
    <string name="welcome_need_title">What you\'ll need</string>
    <string name="welcome_need_drive">A USB drive you can erase: 8 GB or more for a Chromebook, 32 GB or more for a Googlebook</string>
    <string name="welcome_need_adapter">A USB-C adapter, if the drive doesn\'t plug into your phone</string>
    <string name="welcome_need_network">Wi-Fi. Images are 1 to 8 GB.</string>
    <string name="welcome_start">Get started</string>

    <!-- Family -->
    <string name="family_title">What are you recovering?</string>
    <string name="family_body">Your device\'s screen names it when recovery is needed.</string>
    <string name="family_chromebook">Chromebook</string>
    <string name="family_chromebook_hint">Says \"ChromeOS is missing or damaged\"</string>
    <string name="family_googlebook">Googlebook</string>
    <string name="family_googlebook_hint">Says \"Googlebook OS is missing or damaged\"</string>

    <!-- Identify (Chromebook) -->
    <string name="identify_title">Find your Chromebook</string>
    <string name="identify_body">Type the model name shown at the bottom of your Chromebook\'s recovery screen.</string>
    <string name="identify_field">Model name, like SPHERION C4B-K3E</string>
    <string name="identify_find">Find my Chromebook</string>
    <string name="identify_browse">Browse all models</string>
    <string name="identify_no_match">No model matches \"%1$s\". Check the spelling, or browse the list.</string>
    <string name="identify_several">Several models match. Pick yours from the list.</string>

    <!-- Model browser -->
    <string name="models_title_chromebook">Choose your Chromebook</string>
    <string name="models_title_googlebook">Choose your Googlebook</string>
    <string name="models_search">Search models</string>
    <string name="models_none_found">No models match your search.</string>
    <string name="models_googlebook_note">Google adds Googlebooks to its recovery catalog as they ship. If yours isn\'t here yet, Google\'s recovery tool can\'t make a drive for it either.</string>
    <string name="models_pick_prompt">Pick a model to see its recovery images.</string>
    <string name="models_loading">Getting Google\'s recovery catalog</string>
    <string name="models_unavailable_title">Can\'t reach Google\'s catalog</string>
    <string name="models_unavailable_body">Check your connection and try again.</string>
